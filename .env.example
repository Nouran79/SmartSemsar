# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is in .gitignore and must never be committed; this example file has no secrets.

# Vision model that reads furniture photos. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: pin a specific Gemini model instead of the default "gemini-flash-latest"
# SMARTSEMSAR_GEMINI_MODEL=gemini-3.8-flash
# Tried when that model stays busy (503) or is gone (404); default "gemini-flash-lite-latest"
# SMARTSEMSAR_GEMINI_BACKUP_MODEL=gemini-flash-lite-latest
# Models get retired often: python -m backend.services.model_check tries them and shows which work.

# Photo -> 3D runs on this machine by default (TripoSR, no key: pip install -r requirements-photo3d.txt).
# Optional image-to-3D server instead: cv_service/furniture_server_kaggle.ipynb (Hunyuan3D, coloured, Kaggle GPU)
# or cv_service/colab_server.ipynb (TripoSR on Colab). Their last cells print both values.
SMARTSEMSAR_COLAB_URL=
SMARTSEMSAR_COLAB_KEY=

# Furniture planner LLM (backend/services/llm_furnisher.py) uses GEMINI_API_KEY above.
# Optional backups, used when Gemini is busy or not set (Groq also reads photos when Gemini cannot):
# GROQ_API_KEY=            # free key: https://console.groq.com/keys
# SMARTSEMSAR_GROQ_MODEL=openai/gpt-oss-120b          # arranges furniture
# SMARTSEMSAR_GROQ_VISION_MODEL=qwen/qwen3.8-27b      # reads photos
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Hugging Face (image-to-3D through the TRELLIS.2 Space). Read access is enough.
# HF_TOKEN=

# Google Calendar Integration (OAuth 2.0)
# Download OAuth 2.0 client credentials JSON from Google Cloud Console (Desktop application)
# Save as credentials.json in project root or specify the path:
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json
# Default calendar is primary; specify another calendar ID if needed:
GOOGLE_CALENDAR_ID=primary
# Optional direct OAuth credentials (alternative to credentials.json file):
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=

# Telegram Bot Integration for Property Reports
# Create a bot with @BotFather on Telegram and set the token here:
TELEGRAM_BOT_TOKEN=
# The bot username (without @), e.g. SmartSemsarBot:
TELEGRAM_BOT_USERNAME=SmartSemsarBot
